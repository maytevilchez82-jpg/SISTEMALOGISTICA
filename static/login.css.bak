:root {
    --navy: #102c3b;
    --navy-deep: #0a202d;
    --teal: #16889a;
    --teal-light: #47bbc0;
    --amber: #f2a83b;
    --ink: #193442;
    --muted: #78909a;
    --line: #e1e9ec;
}

* { box-sizing: border-box; }
body { min-width: 320px; min-height: 100vh; margin: 0; color: var(--ink); background: #f4f7f8; font-family: 'DM Sans', sans-serif; }
button, input { font: inherit; }
.login-layout { display: grid; min-height: 100vh; grid-template-columns: minmax(0, 1.08fr) minmax(410px, .92fr); }
.login-story { position: relative; display: flex; min-height: 100vh; flex-direction: column; overflow: hidden; padding: 42px clamp(34px, 6vw, 92px) 28px; color: white; background: radial-gradient(ellipse at 83% 13%, rgba(50, 151, 159, .28), transparent 34%), linear-gradient(145deg, var(--navy), var(--navy-deep) 78%); }
.story-grid { position: absolute; inset: 0; opacity: .13; background-image: linear-gradient(rgba(122, 195, 197, .24) 1px, transparent 1px), linear-gradient(90deg, rgba(122, 195, 197, .24) 1px, transparent 1px); background-size: 58px 58px; mask-image: linear-gradient(120deg, black, transparent 85%); pointer-events: none; }
.brand-lockup, .story-copy, .warehouse-card, .story-footer { position: relative; z-index: 1; }
.brand-lockup { display: flex; align-items: center; gap: 19px; width: fit-content; }
.brand-lockup img { display: block; width: 174px; max-height: 58px; object-fit: contain; object-position: left center; filter: brightness(0) invert(1); }
.brand-divider { width: 1px; height: 37px; background: rgba(255,255,255,.25); }
.brand-unit { color: #a9c4ca; font-size: 9px; font-weight: 600; letter-spacing: 1.5px; line-height: 1.7; }
.brand-unit b { color: white; font-size: 8px; letter-spacing: 1px; }
.story-copy { max-width: 600px; margin-top: clamp(58px, 10vh, 110px); }
.section-tag { display: inline-flex; align-items: center; gap: 9px; color: #99c7cb; font-size: 10px; font-weight: 700; letter-spacing: 1.8px; }
.section-tag i, .live-indicator:before { width: 7px; height: 7px; border-radius: 50%; background: var(--amber); box-shadow: 0 0 0 4px rgba(242,168,59,.12); }
.story-copy h1 { margin: 23px 0 16px; font: 700 clamp(38px, 4.8vw, 64px)/1.06 'Space Grotesk', sans-serif; letter-spacing: -2.5px; }
.story-copy h1 em { color: #69c6c5; font-style: normal; }
.story-copy p { max-width: 460px; margin: 0; color: #adc0c5; font-size: 14px; line-height: 1.85; }
.warehouse-card { width: min(100%, 475px); margin: auto auto 22px; padding: 15px 18px 12px; border: 1px solid rgba(172, 221, 219, .19); border-radius: 13px; background: linear-gradient(145deg, rgba(255,255,255,.08), rgba(255,255,255,.025)); box-shadow: 0 24px 65px rgba(0,0,0,.19); }
.warehouse-card-top, .warehouse-card-bottom { display: flex; justify-content: space-between; color: #92adb4; font-size: 8px; font-weight: 700; letter-spacing: 1.1px; }
.live-indicator { display: flex; align-items: center; gap: 7px; color: #86d0c8; font-size: 7px; }
.live-indicator:before { content: ''; width: 5px; height: 5px; background: #73cbbb; box-shadow: none; }
.warehouse-visual { position: relative; display: flex; height: 128px; align-items: end; justify-content: center; gap: 13px; padding-bottom: 17px; }
.shelf { display: flex; width: 72px; height: 91px; flex-direction: column; justify-content: space-between; padding: 5px; border: 2px solid #4f818b; border-bottom-width: 4px; background: repeating-linear-gradient(to bottom, transparent 0 20px, #4f818b 20px 24px); }
.shelf i { width: 15px; height: 13px; margin-left: 3px; border-radius: 2px 2px 0 0; background: #e5a644; box-shadow: 19px 0 #64aaa9; }
.shelf i:nth-child(2) { align-self: end; margin-right: 3px; background: #448e97; box-shadow: -19px 0 #d47f45; }
.shelf-two { height: 111px; }
.shelf-three { height: 79px; }
.floor-line { position: absolute; right: 7%; bottom: 12px; left: 7%; height: 1px; background: linear-gradient(90deg, transparent, #4b7680, transparent); }
.location-pin { position: absolute; right: 7%; bottom: 31px; padding: 7px 10px; border: 1px solid rgba(98,192,191,.25); border-radius: 5px; color: #b8d7d6; background: rgba(10,32,45,.68); font-size: 8px; font-weight: 700; letter-spacing: .7px; }
.location-pin span { margin-right: 5px; color: var(--amber); font-size: 9px; }
.warehouse-card-bottom { padding-top: 10px; border-top: 1px solid rgba(255,255,255,.09); font-size: 7px; }
.story-footer { display: flex; gap: 10px; color: #6e929b; font-size: 9px; }
.login-side { display: flex; min-height: 100vh; flex-direction: column; align-items: center; justify-content: center; padding: 42px; background: linear-gradient(155deg, #fbfcfc, #f2f6f7); }
.login-card { width: min(100%, 405px); padding: 15px 0; }
.mobile-brand { display: none; }
.login-icon { display: grid; width: 52px; height: 52px; place-items: center; margin-bottom: 27px; border: 1px solid #d6e9e9; border-radius: 14px; color: var(--teal); background: #eaf5f4; }
.login-icon svg { width: 27px; height: 27px; }
.form-eyebrow { margin: 0 0 8px; color: var(--teal); font-size: 9px; font-weight: 800; letter-spacing: 1.8px; }
.login-card h2 { margin: 0; color: var(--navy); font: 700 33px 'Space Grotesk', sans-serif; letter-spacing: -.9px; }
.login-intro { margin: 9px 0 31px; color: var(--muted); font-size: 13px; line-height: 1.65; }
#login-form label { display: block; margin-bottom: 9px; color: #355260; font-size: 11px; font-weight: 700; }
.password-field { display: flex; height: 51px; align-items: center; gap: 11px; padding: 0 13px; border: 1px solid #d7e2e5; border-radius: 8px; background: white; transition: border-color .18s, box-shadow .18s; }
.password-field:focus-within { border-color: var(--teal); box-shadow: 0 0 0 3px rgba(22,136,154,.1); }
.password-field > svg { width: 18px; height: 18px; flex: 0 0 18px; color: #8ba1a9; }
.password-field input { width: 100%; min-width: 0; height: 100%; border: 0; outline: 0; color: var(--ink); background: transparent; font-size: 12px; }
.password-field input::placeholder { color: #a3b2b7; }
.password-toggle { padding: 5px 0 5px 5px; border: 0; color: var(--teal); background: transparent; cursor: pointer; font-size: 10px; font-weight: 700; }
.form-message { display: none; margin: 10px 0 0; padding: 10px 12px; border: 1px solid #f1c9c3; border-radius: 7px; color: #a14337; background: #fff5f3; font-size: 11px; line-height: 1.5; }
.form-message.visible { display: block; }
.form-message.setup-message { border-color: #f0dcaa; color: #795617; background: #fff9eb; }
.login-submit { display: flex; width: 100%; height: 50px; align-items: center; justify-content: center; gap: 12px; margin-top: 19px; border: 0; border-radius: 8px; color: white; background: linear-gradient(100deg, #17899a, #126d82); box-shadow: 0 8px 17px rgba(18,109,130,.17); cursor: pointer; font-size: 12px; font-weight: 700; transition: transform .16s, box-shadow .16s, opacity .16s; }
.login-submit:hover { transform: translateY(-1px); box-shadow: 0 11px 21px rgba(18,109,130,.23); }
.login-submit:disabled { cursor: wait; opacity: .73; }
.login-submit svg { width: 17px; height: 17px; }
.login-submit.loading svg { animation: nudge .8s ease-in-out infinite alternate; }
@keyframes nudge { to { transform: translateX(4px); } }
.secure-note { display: flex; align-items: center; gap: 8px; margin-top: 20px; color: #83969d; font-size: 10px; }
.secure-note svg { width: 16px; height: 16px; flex: 0 0 16px; color: #41968e; }
.visitor-link { display: block; width: fit-content; margin-top: 31px; color: #607b85; font-size: 11px; font-weight: 600; text-decoration: none; }
.visitor-link span { margin-left: 3px; color: var(--teal); }
.visitor-link:hover { color: var(--teal); }
.login-footer { margin-top: auto; padding-top: 30px; color: #9aabb0; font-size: 9px; }
.login-footer span { margin: 0 5px; color: #c0cccf; }

@media (max-width: 850px) {
    .login-layout { grid-template-columns: minmax(0, 1fr) minmax(350px, .9fr); }
    .login-story { padding-right: 38px; padding-left: 38px; }
    .story-copy h1 { font-size: clamp(36px, 5.5vw, 48px); }
    .warehouse-card { margin-bottom: 22px; }
    .login-side { padding: 34px; }
}
@media (max-width: 650px) {
    .login-layout { display: block; min-height: 100vh; }
    .login-story { display: none; }
    .login-side { min-height: 100vh; justify-content: center; padding: 28px 25px; }
    .login-card { width: min(100%, 410px); }
    .mobile-brand { display: flex; align-items: center; gap: 14px; margin-bottom: 47px; }
    .mobile-brand img { width: 145px; max-height: 42px; object-fit: contain; object-position: left center; }
    .mobile-brand span { padding-left: 13px; border-left: 1px solid #cfdddf; color: var(--teal); font-size: 9px; font-weight: 800; letter-spacing: 1.2px; }
    .login-footer { padding-top: 40px; }
}

/* Pulido visual de la pantalla de acceso */
.login-story { isolation: isolate; background: radial-gradient(ellipse at 18% 82%, rgba(21, 119, 136, .22), transparent 32%), radial-gradient(ellipse at 85% 17%, rgba(65, 171, 171, .25), transparent 34%), linear-gradient(145deg, #112f40 0%, #0b2432 63%, #081d29 100%); }
.login-story:after { position: absolute; z-index: -1; top: -28%; right: -22%; width: min(60vw, 770px); aspect-ratio: 1; border: 1px solid rgba(105,198,197,.12); border-radius: 50%; box-shadow: 0 0 0 54px rgba(105,198,197,.025), 0 0 0 112px rgba(105,198,197,.02); content: ''; pointer-events: none; }
.story-orbit { position: absolute; z-index: -1; border: 1px solid rgba(99,196,195,.13); border-radius: 50%; pointer-events: none; }
.orbit-one { top: 19%; right: -15%; width: 390px; height: 390px; }
.orbit-two { top: 26%; right: -10%; width: 280px; height: 280px; border-color: rgba(241,170,69,.15); }
.story-index { position: absolute; top: 39%; right: 8%; color: rgba(160,208,207,.19); font: 700 11px/1.4 'Space Grotesk', sans-serif; letter-spacing: 3px; }
.story-index b { color: rgba(160,208,207,.11); font-size: 66px; letter-spacing: -5px; }
.brand-lockup img { width: 190px; }
.brand-divider { background: linear-gradient(transparent, rgba(255,255,255,.36), transparent); }
.story-copy { animation: rise-in .7s cubic-bezier(.2,.7,.2,1) both; }
.story-copy h1 { text-shadow: 0 8px 35px rgba(0,0,0,.18); }
.story-copy h1 em { color: transparent; background: linear-gradient(100deg, #7ad9d0, #56b8c3 75%); -webkit-background-clip: text; background-clip: text; }
.section-tag { padding: 8px 11px; border: 1px solid rgba(132,206,202,.2); border-radius: 999px; background: rgba(17,82,93,.28); }
.warehouse-card { position: relative; overflow: hidden; width: min(100%, 500px); padding: 16px 18px 13px; border-color: rgba(143,213,208,.23); border-radius: 16px; background: linear-gradient(135deg, rgba(255,255,255,.105), rgba(255,255,255,.035)); box-shadow: 0 26px 70px rgba(0,0,0,.26), inset 0 1px rgba(255,255,255,.1); animation: rise-in .9s .13s cubic-bezier(.2,.7,.2,1) both; }
.warehouse-card:before { position: absolute; top: -72px; right: -40px; width: 180px; height: 180px; border-radius: 50%; background: rgba(68,173,171,.13); filter: blur(30px); content: ''; }
.warehouse-card-top, .warehouse-card-bottom { position: relative; z-index: 1; }
.warehouse-card-top { color: #abc4c8; }
.warehouse-visual { height: 151px; perspective: 500px; }
.shelf { width: 78px; height: 98px; border-color: #598992; background: repeating-linear-gradient(to bottom, rgba(19,67,78,.4) 0 20px, #598992 20px 24px); box-shadow: 8px 8px 20px rgba(0,0,0,.15); transform: rotateY(-7deg); }
.shelf-two { height: 120px; width: 82px; }
.shelf-three { height: 84px; }
.shelf i { background: linear-gradient(135deg, #f4bd62, #d58c3d); box-shadow: 19px 0 #69b8b3; }
.shelf i:nth-child(2) { background: linear-gradient(135deg, #62b9b8, #368d96); box-shadow: -19px 0 #d88b4e; }
.floor-line { bottom: 10px; height: 2px; background: linear-gradient(90deg, transparent, rgba(93,175,178,.6), transparent); }
.location-pin { right: 4%; bottom: 32px; border-color: rgba(120,215,206,.28); box-shadow: 0 8px 20px rgba(0,0,0,.16); }
.inventory-float { position: absolute; z-index: 2; top: 19px; right: 1%; display: flex; align-items: center; gap: 9px; padding: 9px 11px; border: 1px solid rgba(204,239,231,.24); border-radius: 8px; color: #effafa; background: rgba(10,35,47,.86); box-shadow: 0 9px 24px rgba(0,0,0,.2); animation: float 4s ease-in-out infinite; }
.float-icon { display: grid; width: 24px; height: 24px; place-items: center; border-radius: 6px; color: #072b37; background: #83d5c9; font-size: 14px; font-weight: 800; }
.inventory-float > span:nth-child(2) { display: grid; gap: 2px; }
.inventory-float b { font-size: 9px; }
.inventory-float small { color: #88aeb4; font-size: 6px; font-weight: 700; letter-spacing: .8px; }
.float-bars { display: flex; height: 24px; align-items: end; gap: 2px; margin-left: 3px; }
.float-bars b { width: 3px; border-radius: 3px 3px 0 0; background: #59b7b2; }
.float-bars b:nth-child(1), .float-bars b:nth-child(5) { height: 8px; opacity: .58; }
.float-bars b:nth-child(2), .float-bars b:nth-child(4) { height: 14px; opacity: .78; }
.float-bars b:nth-child(3) { height: 22px; }
.warehouse-card-bottom { gap: 10px; color: #9eb8be; }
.warehouse-card-bottom span:last-child { color: #76c8be; }
.story-footer { color: #82a3ab; }
.login-side { position: relative; isolation: isolate; overflow: hidden; background: radial-gradient(ellipse at 100% 5%, rgba(215,236,234,.56), transparent 35%), linear-gradient(145deg, #fbfcfc, #f0f5f6); }
.login-side:before { position: absolute; z-index: -1; right: -170px; bottom: -220px; width: 440px; height: 440px; border: 1px solid rgba(22,136,154,.07); border-radius: 50%; box-shadow: 0 0 0 35px rgba(22,136,154,.025), 0 0 0 75px rgba(22,136,154,.02); content: ''; }
.side-topline { position: absolute; top: 35px; right: 42px; left: 42px; display: flex; justify-content: space-between; color: #8ca0a6; font-size: 8px; font-weight: 800; letter-spacing: 1.4px; }
.side-topline b { color: var(--amber); }
.side-topline span:last-child { display: flex; align-items: center; gap: 7px; color: #638078; font-size: 7px; }
.side-topline i { width: 6px; height: 6px; border-radius: 50%; background: #56b99a; box-shadow: 0 0 0 4px rgba(86,185,154,.12); }
.login-card { position: relative; width: min(100%, 420px); padding: 39px 37px 34px; border: 1px solid rgba(212,225,228,.9); border-radius: 18px; background: rgba(255,255,255,.9); box-shadow: 0 25px 70px rgba(22,58,73,.1), 0 3px 10px rgba(22,58,73,.035), inset 0 1px white; animation: rise-in .65s .08s cubic-bezier(.2,.7,.2,1) both; backdrop-filter: blur(12px); }
.login-icon { width: 54px; height: 54px; margin-bottom: 24px; border-color: #d0e8e5; border-radius: 16px; color: #137d8e; background: linear-gradient(145deg, #eaf8f5, #e4f1f3); box-shadow: inset 0 1px white, 0 7px 18px rgba(21,126,139,.08); }
.form-eyebrow { letter-spacing: 2px; }
.login-card h2 { font-size: 35px; }
.login-intro { margin-bottom: 27px; }
.password-field { height: 53px; border-radius: 9px; box-shadow: 0 2px 4px rgba(16,44,59,.025); }
.login-submit { height: 53px; border-radius: 9px; background: linear-gradient(100deg, #178a9b 0%, #116d82 100%); box-shadow: 0 8px 17px rgba(18,109,130,.2), inset 0 1px rgba(255,255,255,.2); }
.secure-note { margin-top: 18px; }
.visitor-link { padding-bottom: 3px; border-bottom: 1px solid rgba(22,136,154,.22); }
.login-footer { position: absolute; bottom: 28px; }
@keyframes rise-in { from { opacity: 0; transform: translateY(13px); } to { opacity: 1; transform: translateY(0); } }
@keyframes float { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-4px); } }

@media (max-width: 1050px) {
    .brand-lockup img { width: 155px; }
    .warehouse-card-bottom { font-size: 6px; }
    .inventory-float { right: -1%; transform: scale(.92); transform-origin: right top; }
    .login-card { padding-right: 29px; padding-left: 29px; }
}
@media (max-width: 850px) {
    .side-topline { right: 26px; left: 26px; }
    .login-card { padding: 34px 25px 30px; }
    .warehouse-visual { height: 137px; }
    .warehouse-card-bottom span:nth-child(2) { display: none; }
}
@media (max-width: 760px) and (min-width: 651px) {
    .login-layout { grid-template-columns: minmax(0, 1fr) minmax(340px, 1fr); }
    .login-story { padding-right: 25px; padding-left: 25px; }
    .brand-lockup { gap: 12px; }
    .brand-lockup img { width: 128px; }
    .story-copy h1 { font-size: 35px; letter-spacing: -1.7px; }
    .story-copy p { font-size: 12px; }
    .login-side { padding-right: 24px; padding-left: 24px; }
}
@media (max-width: 650px) {
    .side-topline { display: none; }
    .login-side { overflow: auto; padding: 25px 22px; }
    .login-card { width: min(100%, 420px); padding: 30px 25px 27px; box-shadow: 0 18px 48px rgba(22,58,73,.09); }
    .mobile-brand { margin-bottom: 34px; }
    .login-icon { width: 48px; height: 48px; margin-bottom: 20px; }
    .login-card h2 { font-size: 31px; }
    .login-footer { position: static; padding-top: 26px; }
}
@media (prefers-reduced-motion: reduce) {
    *, *:before, *:after { animation-duration: .01ms !important; animation-iteration-count: 1 !important; scroll-behavior: auto !important; }
}

/* Composición de acceso alineada con la referencia */
.login-layout { grid-template-columns: minmax(0, 2fr) minmax(480px, 1fr); }
.login-story { padding: 35px clamp(32px, 3.4vw, 56px) 24px; background: radial-gradient(ellipse at 78% 66%, rgba(37,111,128,.36), transparent 39%), linear-gradient(110deg, #062333 0%, #0a2b3b 50%, #123b4b 100%); }
.login-story:after { top: -8%; right: -13%; width: min(46vw, 650px); opacity: .5; }
.story-grid { opacity: .08; }
.orbit-one, .orbit-two, .story-index { display: none; }
.brand-lockup img { width: 180px; }
.story-copy { max-width: 730px; margin-top: clamp(37px, 5.5vh, 64px); }
.story-copy h1 { max-width: 700px; margin: 21px 0 13px; font-size: clamp(40px, 3.45vw, 58px); letter-spacing: -2px; }
.story-copy p { max-width: 650px; font-size: 15px; }
.story-metrics { position: relative; z-index: 1; display: grid; width: min(100%, 810px); grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 13px; margin-top: 31px; }
.story-metrics article { display: grid; min-height: 126px; align-content: start; padding: 14px 15px 12px; border: 1px solid rgba(150,213,216,.25); border-radius: 11px; background: linear-gradient(145deg, rgba(7,37,52,.82), rgba(12,48,62,.65)); box-shadow: inset 0 1px rgba(255,255,255,.04), 0 9px 24px rgba(0,0,0,.1); }
.metric-symbol { height: 25px; font-size: 20px; font-weight: 700; }
.metric-symbol.amber { color: #f4a529; }
.metric-symbol.cyan { color: #18c1d3; }
.story-metrics small { margin-top: 5px; color: #e5f0f2; font-size: 11px; font-weight: 600; }
.story-metrics strong { margin-top: 8px; color: white; font: 700 24px 'Space Grotesk', sans-serif; letter-spacing: -.5px; }
.story-metrics label { margin-top: 1px; color: #a7c0c7; font-size: 10px; }
.warehouse-card { width: min(100%, 875px); margin: auto 0 13px; padding: 14px 17px 11px; border-color: rgba(174,219,218,.36); border-radius: 13px; background: linear-gradient(105deg, rgba(8,39,53,.88), rgba(13,49,62,.81)); box-shadow: 0 20px 50px rgba(0,0,0,.23), inset 0 1px rgba(255,255,255,.08); }
.ops-preview { position: relative; display: grid; min-height: 160px; grid-template-columns: 1.13fr 1fr .54fr; gap: 15px; margin-top: 12px; }
.locker-map, .activity-preview, .scan-card { min-width: 0; padding: 9px 10px; border: 1px solid rgba(110,172,184,.21); border-radius: 7px; background: rgba(5,34,48,.46); }
.zone-label, .activity-title { margin-bottom: 9px; color: #b7d1d5; font-size: 7px; font-weight: 800; letter-spacing: 1px; }
.locker-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 5px; }
.locker-grid span { display: grid; height: 39px; place-items: center; border: 1px solid rgba(62,149,165,.34); border-radius: 4px; color: #c3d9db; background: linear-gradient(145deg, rgba(25,91,106,.53), rgba(10,49,64,.7)); font-size: 8px; font-weight: 700; }
.locker-grid span:nth-child(3n) { color: #ffbf62; background: linear-gradient(145deg, rgba(145,88,27,.42), rgba(10,49,64,.75)); }
.locker-grid span:nth-child(4n) { color: #6cc7c5; }
.locker-legend { display: flex; align-items: center; gap: 6px; margin-top: 9px; color: #a7c0c7; font-size: 7px; }
.locker-legend i { width: 7px; height: 7px; margin-left: 4px; border-radius: 50%; background: #0fa3b7; }
.locker-legend i:nth-of-type(2) { background: #607f89; }
.locker-legend i:nth-of-type(3) { background: #f09a20; }
.activity-preview { padding-right: 7px; padding-left: 10px; }
.activity-title { padding-bottom: 7px; border-bottom: 1px solid rgba(110,172,184,.18); }
.preview-row { display: grid; min-height: 30px; grid-template-columns: 15px minmax(0,1fr) auto; align-items: center; gap: 6px; border-bottom: 1px solid rgba(110,172,184,.1); color: #d6e5e7; font-size: 8px; }
.preview-row > i { color: #65bbc0; font-size: 12px; font-style: normal; }
.preview-row > span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.preview-row small { display: block; margin-top: 2px; color: #8eafb7; font-size: 7px; }
.preview-row > b { color: #9ebdc4; font-size: 7px; font-weight: 500; }
.preview-empty { padding: 22px 0; color: #9bb9c0; font-size: 8px; }
.scan-card { display: flex; flex-direction: column; justify-content: center; align-items: center; padding: 8px; }
.scan-graphic { position: relative; display: grid; width: 100%; height: 98px; place-items: center; overflow: hidden; border-radius: 4px; color: #d7e9eb; background: repeating-linear-gradient(145deg, #173b4c 0 9px, #21495a 10px 17px); }
.scan-graphic:before { position: absolute; top: 50%; right: 8%; left: 8%; height: 1px; background: #fa6b43; box-shadow: 0 0 8px #fa6b43; content: ''; }
.scan-graphic i { font-size: 35px; font-style: normal; text-shadow: 0 3px 12px #00131c; }
.scan-graphic span { position: absolute; width: 60%; height: 65%; border: 1px solid rgba(107,215,213,.62); border-radius: 4px; }
.scan-card > small { margin-top: 7px; color: #a9c6cc; font-size: 6px; font-weight: 800; letter-spacing: .6px; }
.warehouse-card-bottom { padding-top: 8px; }
.story-footer { font-size: 9px; }
.login-side { padding: 75px clamp(28px, 3vw, 48px) 58px; }
.side-topline { top: 32px; right: clamp(28px, 3vw, 48px); left: clamp(28px, 3vw, 48px); }
.login-card { width: min(100%, 435px); padding: 34px 34px 28px; }
.login-icon { width: 50px; height: 50px; margin-bottom: 21px; }
.login-card h2 { font-size: 34px; }
.login-intro { margin: 8px 0 24px; }
.form-message { margin-bottom: 0; }
.live-dashboard { margin-top: 24px; }
.live-dashboard-heading { display: flex; align-items: center; justify-content: space-between; gap: 8px; margin-bottom: 11px; color: #188ba0; font-size: 8px; font-weight: 800; letter-spacing: 1px; }
.live-dashboard-heading span, .live-dashboard-heading b { display: flex; align-items: center; gap: 7px; }
.live-dashboard-heading span i { width: 5px; height: 5px; border-radius: 50%; background: #f3a631; }
.live-dashboard-heading b { color: #729187; font-size: 8px; font-weight: 600; letter-spacing: 0; }
.live-dashboard-heading b i { width: 7px; height: 7px; border-radius: 50%; background: #49b895; box-shadow: 0 0 0 4px rgba(73,184,149,.13); }
.live-dashboard-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; }
.live-dashboard-grid article { display: flex; min-width: 0; min-height: 54px; align-items: center; gap: 9px; padding: 8px; border: 1px solid #dce7e9; border-radius: 8px; background: linear-gradient(140deg, #fff, #f8fbfb); }
.live-icon { display: grid; width: 24px; height: 24px; flex: 0 0 24px; place-items: center; color: #0c91a3; font-size: 17px; font-weight: 700; }
.live-dashboard-grid p { display: grid; min-width: 0; gap: 3px; margin: 0; color: #365766; font-size: 8px; line-height: 1.2; }
.live-dashboard-grid strong { overflow: hidden; color: #54717c; font-size: 8px; font-weight: 500; text-overflow: ellipsis; white-space: nowrap; }
.visitor-link { margin-top: 21px; }
.login-footer { bottom: 20px; }

@media (max-width: 1150px) and (min-width: 851px) {
    .login-layout { grid-template-columns: minmax(0, 1.75fr) minmax(430px, 1fr); }
    .story-metrics { gap: 8px; }
    .story-metrics article { padding-right: 10px; padding-left: 10px; }
    .ops-preview { grid-template-columns: 1fr 1fr; }
    .scan-card { display: none; }
}
@media (max-width: 850px) and (min-width: 651px) {
    .login-layout { grid-template-columns: minmax(0, 1.55fr) minmax(380px, 1fr); }
    .login-story { padding: 30px 25px 20px; }
    .story-metrics article { min-height: 112px; padding: 10px; }
    .story-metrics strong { font-size: 20px; }
    .story-metrics small, .story-metrics label { font-size: 9px; }
    .ops-preview { grid-template-columns: 1fr; }
    .activity-preview, .scan-card { display: none; }
    .login-side { padding-right: 19px; padding-left: 19px; }
}
@media (max-width: 650px) {
    .login-layout { display: block; }
    .login-story { display: flex; min-height: auto; padding: 27px 22px 21px; }
    .brand-lockup img { width: 140px; }
    .brand-unit { font-size: 8px; }
    .story-copy { margin-top: 35px; }
    .story-copy h1 { font-size: 35px; }
    .story-copy p { font-size: 12px; }
    .story-metrics { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; margin-top: 20px; }
    .story-metrics article { min-height: 98px; padding: 9px 11px; }
    .story-metrics strong { margin-top: 4px; font-size: 19px; }
    .metric-symbol { height: 21px; font-size: 17px; }
    .warehouse-card { margin: 20px 0 15px; }
    .ops-preview { min-height: 0; grid-template-columns: 1fr 1fr; gap: 7px; }
    .locker-map { grid-column: 1 / -1; }
    .locker-grid span { height: 30px; }
    .activity-preview { display: block; }
    .scan-card { display: none; }
    .login-story .story-footer { font-size: 8px; }
    .login-side { min-height: auto; overflow: visible; padding: 28px 22px 20px; }
    .side-topline { display: none; }
    .login-card { width: min(100%, 435px); padding: 25px 22px 22px; }
    .mobile-brand { margin-bottom: 27px; }
    .login-footer { position: static; padding-top: 18px; }
}
